# Dockerfile para desenvolvimento local.
#
# Diferente do `Dockerfile` de produção:
#   - Sem CUDA (devs podem usar CPU; produção usa GPU)
#   - Sem build estático do Next.js (monta volume com código fonte + hot reload)
#   - Roda como root (dev only; prod usa usuário não-root)
#   - Expoe 3000 (Next dev) e 8000 (FastAPI) separados
#
# Uso:
#   docker build -f Dockerfile.dev -t youface-dev .
#   docker run --rm -it -p 8000:8000 -p 3000:3000 \
#     -v $(pwd):/app -v /app/frontend/node_modules \
#     youface-dev
#
# Ou via compose:
#   docker compose -f docker-compose.dev.yml up

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps mínimos (sem CUDA)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt /app/
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install onnxruntime

# Instala Node 20 e deps de dev do frontend
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

COPY frontend/package*.json /app/frontend/
RUN cd /app/frontend && npm ci

# Copia o restante
COPY . /app

EXPOSE 8000 3000

# Default: backend only. Em dev, frontend roda com `npm run dev` num
# terminal separado (ou via docker-compose com dois serviços).
CMD ["python", "run_api.py"]
